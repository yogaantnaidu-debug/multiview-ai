# Copy this file to .env (which git ignores) and fill in your own key.
# Leave LLM_API_KEY empty to run with Chat Pulse off: the grid, hype bars
# and Director still work.

# Groq (OpenAI-compatible endpoint)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-20b
# gpt-oss is a reasoning model; "low" keeps its thinking (and token use) short.
# Delete this line for non-reasoning models, which may reject the parameter.
LLM_REASONING_EFFORT=low

# Example: Gemini's OpenAI-compatible endpoint instead
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=<a current Gemini Flash model id>
